# Public origin used for canonical URLs, hreflang, sitemap and Open Graph.
# Change only once the production domain is confirmed.
SITE_URL=https://valtraxenergy.com

# Search indexing. Leave unset (or "false") for previews and pre-launch builds:
# every page then carries `noindex, nofollow` and robots.txt disallows crawling.
# Set to "true" ONLY in the Vercel *Production* environment at launch.
SITE_INDEXING=false

# Enquiry form delivery (Resend, https://resend.com). All three are required;
# without them the form endpoint answers 503 and the page states that the form is unavailable.
RESEND_API_KEY=
# Approved recipient mailbox for enquiries (comma-separate for several). Must be confirmed by the owner.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Valtrax Energy website <website@valtraxenergy.com>"
CONTACT_FROM_EMAIL=
