# Public origin used for canonical URLs, hreflang, sitemap and Open Graph.
# Change only once the production domain is confirmed.
SITE_URL=https://valtraxenergy.com

# Search indexing. Leave unset (or "false") for previews and pre-launch builds:
# every page then carries `noindex, nofollow` and robots.txt disallows crawling.
# Set to "true" ONLY in the Vercel *Production* environment at launch.
SITE_INDEXING=false

# Enquiry form delivery (Resend, https://resend.com). Both are required; without them the
# form endpoint answers 503 and the page states that the form is unavailable.
# The recipient is fixed in src/config/site.ts (formRecipient: info@valtraxenergy.com).
RESEND_API_KEY=
# Sender on the domain verified in Resend. Must be on valtraxenergy.com or a subdomain of it,
# e.g. "Valtrax Energy website <website@notify.valtraxenergy.com>" (see docs/DNS-AND-EMAIL.md).
CONTACT_FROM_EMAIL=
