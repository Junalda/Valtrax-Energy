---
// Homepage of the multi-page site: introduction, entry points to the content pages and a call to contact.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Overview from './Overview.astro';
import Audiences from './Audiences.astro';
import CtaBand from './CtaBand.astro';
import Footer from './Footer.astro';
import { t, pathFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const contact = pathFor('contact', lang);
---

<Base lang={lang} page="home" title={dict.meta.title} description={dict.meta.description}>
  <Header lang={lang} page="home" />
  <main id="main" tabindex="-1">
    <Hero lang={lang} contactHref={contact} expertiseHref={`${pathFor('about', lang)}#expertise`} />
    <Overview lang={lang} />
    <Audiences lang={lang} contactPath={contact} />
    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} page="home" />
</Base>

<script>
  import '../scripts/site.ts';
</script>
