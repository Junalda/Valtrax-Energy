---
import Arrow from './Arrow.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);

// Chart composition (pure SVG, no imagery): a navigational-chart graticule and range
// rings centred on the ARA region. Purely illustrative — it depicts a market focus,
// not assets.
const size = 560;
const c = size / 2;
const rings = [48, 96, 150, 210, 270];
const grid = Array.from({ length: 15 }, (_, i) => i * 40);
const bearings = Array.from({ length: 12 }, (_, i) => (i * 30 * Math.PI) / 180);
// Outbound bearings towards the international hubs (approximate great-circle headings).
const routes = [
  { label: 'Houston', angle: 285, r: 262 },
  { label: 'Fujairah', angle: 112, r: 248 },
  { label: 'Jurong', angle: 78, r: 262 },
];
const rad = (deg: number) => ((deg - 90) * Math.PI) / 180;
const pt = (deg: number, r: number) => ({ x: c + r * Math.cos(rad(deg)), y: c + r * Math.sin(rad(deg)) });
const arc = (deg: number, r: number) => {
  const end = pt(deg, r);
  // Gentle curve: control point offset perpendicular to the bearing.
  const mid = pt(deg - 14, r * 0.55);
  return `M ${c} ${c} Q ${mid.x.toFixed(1)} ${mid.y.toFixed(1)} ${end.x.toFixed(1)} ${end.y.toFixed(1)}`;
};
---

<section class="hero on-navy" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{dict.hero.eyebrow}</p>
      <h1 id="hero-title">{dict.hero.title}</h1>
      <p class="hero__lead">{dict.hero.lead}</p>
      <p class="hero__role">{dict.hero.role}</p>
      <div class="hero__actions">
        <a class="btn btn--gold" href="#contact">{dict.hero.primary}<Arrow /></a>
        <a class="btn btn--ghost" href="#expertise">{dict.hero.secondary}</a>
      </div>
    </div>

    <figure class="hero__chart">
      <svg viewBox={`0 0 ${size} ${size}`} width={size} height={size} aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="hero-fade" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fff" stop-opacity="1"></stop>
            <stop offset="75%" stop-color="#fff" stop-opacity="0.55"></stop>
            <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
          </radialGradient>
          <mask id="hero-mask"><rect width={size} height={size} fill="url(#hero-fade)"></rect></mask>
        </defs>
        <g mask="url(#hero-mask)">
          <g class="chart-grid">
            {grid.map((v) => <line x1={v} y1="0" x2={v} y2={size} />)}
            {grid.map((v) => <line x1="0" y1={v} x2={size} y2={v} />)}
          </g>
          <g class="chart-bearings">
            {
              bearings.map((a) => (
                <line x1={c} y1={c} x2={(c + 280 * Math.cos(a)).toFixed(1)} y2={(c + 280 * Math.sin(a)).toFixed(1)} />
              ))
            }
          </g>
          <g class="chart-rings">
            {rings.map((r, i) => <circle cx={c} cy={c} r={r} class={i === 1 ? 'is-accent' : undefined} />)}
          </g>
          <g class="chart-ticks">
            {
              Array.from({ length: 72 }, (_, i) => {
                const a = (i * 5 * Math.PI) / 180;
                const r1 = 270;
                const r2 = i % 6 === 0 ? 258 : 264;
                return (
                  <line
                    x1={(c + r1 * Math.cos(a)).toFixed(1)}
                    y1={(c + r1 * Math.sin(a)).toFixed(1)}
                    x2={(c + r2 * Math.cos(a)).toFixed(1)}
                    y2={(c + r2 * Math.sin(a)).toFixed(1)}
                  />
                );
              })
            }
          </g>
          <g class="chart-routes">
            {routes.map((r) => <path d={arc(r.angle, r.r)} />)}
          </g>
        </g>
        <g class="chart-labels">
          {
            routes.map((r) => {
              const p = pt(r.angle, r.r - 22);
              return (
                <text x={p.x.toFixed(1)} y={p.y.toFixed(1)} text-anchor={r.angle > 180 ? 'start' : 'end'}>
                  {r.label}
                </text>
              );
            })
          }
          <text x={c + 14} y={c - 12} class="chart-label--main">{dict.hero.chartLabel}</text>
          <text x={c + 14} y={c + 8} class="chart-label--coords">51.9° N · 4.1° E</text>
        </g>
        <circle cx={c} cy={c} r="18" class="chart-pulse"></circle>
        <circle cx={c} cy={c} r="5" class="chart-dot"></circle>
      </svg>
      <figcaption>{dict.hero.chartCaption}</figcaption>
    </figure>
  </div>

  <div class="hero__strap">
    <div class="container">
      <ul>
        {dict.hero.strap.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy-900);
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }
  .hero::before {
    /* Fine horizon line motif */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 60% at 78% 45%, rgba(21, 66, 118, 0.55), transparent 70%),
      linear-gradient(180deg, var(--navy-950) 0%, var(--navy-900) 60%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(4rem, 2.5rem + 6vw, 8rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }
  .hero__copy {
    display: grid;
    gap: 1.5rem;
    max-width: 44rem;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .hero__lead {
    font-size: var(--step-1);
    line-height: 1.55;
    color: #dfe5ee;
    max-width: 36rem;
  }
  .hero__role {
    max-width: 34rem;
    padding-left: 1rem;
    border-left: 1px solid var(--gold-500);
    color: var(--navy-300);
    font-size: 0.97rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 0.75rem;
  }

  .hero__chart {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 34rem;
  }
  .hero__chart svg {
    width: 100%;
    height: auto;
  }
  .hero__chart figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--navy-300);
  }
  .chart-grid line {
    stroke: rgba(255, 255, 255, 0.06);
    stroke-width: 1;
  }
  .chart-bearings line {
    stroke: rgba(255, 255, 255, 0.07);
    stroke-width: 1;
  }
  .chart-rings circle {
    fill: none;
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 1;
  }
  .chart-rings circle.is-accent {
    stroke: rgba(190, 138, 34, 0.8);
    stroke-dasharray: 2 5;
  }
  .chart-ticks line {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1;
  }
  .chart-routes path {
    fill: none;
    stroke: var(--gold-500);
    stroke-width: 1.25;
    stroke-dasharray: 1 6;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .chart-labels text {
    fill: var(--navy-300);
    font: 500 13px var(--font-sans);
    letter-spacing: 0.08em;
  }
  .chart-labels .chart-label--main {
    fill: var(--white);
    font: 600 15px var(--font-sans);
    letter-spacing: 0.1em;
  }
  .chart-labels .chart-label--coords {
    fill: var(--gold-500);
    font-size: 12px;
  }
  .chart-dot {
    fill: var(--gold-500);
  }
  .chart-pulse {
    fill: none;
    stroke: var(--gold-500);
    stroke-width: 1;
    transform-origin: center;
    transform-box: fill-box;
    animation: pulse 4s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      opacity: 0.8;
      transform: scale(0.4);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-pulse {
      animation: none;
      opacity: 0.5;
    }
  }

  .hero__strap {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .hero__strap ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    padding-block: 1.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-300);
  }
  .hero__strap li + li::before {
    content: '·';
    margin-inline: 0.9rem;
    color: var(--gold-500);
  }

  @media (max-width: 60rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__chart {
      justify-self: center;
      max-width: 24rem;
      order: 2;
    }
  }
  @media (max-width: 30rem) {
    .hero__actions .btn {
      width: 100%;
    }
    .hero__chart {
      max-width: 19rem;
    }
    .hero__strap ul {
      flex-direction: column;
      gap: 0.4rem;
    }
    .hero__strap li + li::before {
      content: none;
    }
  }
</style>
