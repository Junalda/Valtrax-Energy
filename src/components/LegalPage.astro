---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import LegalText from './LegalText.astro';
import { site } from '../config/site';
import { t, pathFor, legalPages, type Lang, type LegalPageKey } from '../i18n';
import { legalDoc, countDrafts, publicationBlockers } from '../legal';

interface Props {
  lang: Lang;
  page: LegalPageKey;
}
const { lang, page } = Astro.props;
const dict = t(lang);
const doc = legalDoc(page, lang);
const drafts = countDrafts(doc);
const blockers = publicationBlockers(doc);

// Unresolved items (internal review list or [[...]] markers) must never reach the
// production (indexable) site.
if (site.indexable && blockers > 0) {
  throw new Error(
    `Legal page "${page}" (${lang}) has ${blockers} unresolved publication blocker(s) ` +
      '(see `review` and [[...]] in src/legal/*.ts). Resolve them before building with SITE_INDEXING=true.',
  );
}

const updatedLabel = new Intl.DateTimeFormat(lang === 'nl' ? 'nl-NL' : 'en-GB', { dateStyle: 'long' }).format(
  new Date(`${doc.updated}T12:00:00Z`),
);
const c = dict.legal.company;
const pc = site.publicContact;
const companyRows: [string, string, string?][] = [
  [c.legalName, site.legalName],
  [c.tradingName, site.brand],
  [c.address, [pc.streetAddress, [pc.postalCode, site.registeredLocality].filter(Boolean).join(' '), site.country[lang]].filter(Boolean).join(', ')],
  [c.kvk, site.kvk],
  [c.vat, site.vat],
  ...(pc.email ? ([[c.email, pc.email, `mailto:${pc.email}`]] as [string, string, string][]) : []),
  [c.website, site.website.replace(/^https?:\/\//, ''), site.website],
];
const related = legalPages.filter((p) => p !== page);
---

<Base lang={lang} page={page} title={doc.metaTitle} description={doc.metaDescription}>
  <Header lang={lang} page={page} />
  <main id="main" tabindex="-1" class="legal-main">
    <article class="container legal" aria-labelledby="legal-title">
      <header class="legal__head">
        <p class="eyebrow">{site.brand}</p>
        <h1 id="legal-title">{doc.title}</h1>
        <p class="legal__updated">{dict.legal.lastUpdated}: <time datetime={doc.updated}>{updatedLabel}</time></p>
        <p class="legal__intro">{doc.intro}</p>
        {
          drafts > 0 && (
            <p class="legal__draft-banner" role="note">
              {dict.legal.draftBanner}
            </p>
          )
        }
        <div class="legal__actions">
          <button type="button" class="text-link legal__print" data-print hidden>{dict.legal.print}</button>
        </div>
      </header>

      <nav class="legal__toc" aria-labelledby="legal-toc-title">
        <h2 id="legal-toc-title">{dict.legal.toc}</h2>
        <ol>
          {doc.sections.map((s) => <li><a href={`#${s.id}`}>{s.title.replace(/^\d+\.\s*/, '')}</a></li>)}
        </ol>
      </nav>

      {
        doc.sections.map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            {section.blocks.map((block) =>
              block.type === 'p' ? (
                <p>
                  <LegalText text={block.text} lang={lang} />
                </p>
              ) : block.type === 'list' ? (
                <ul>
                  {block.items.map((item) => (
                    <li>
                      <LegalText text={item} lang={lang} />
                    </li>
                  ))}
                </ul>
              ) : block.type === 'table' ? (
                <div class="legal__table" role="region" aria-label={block.caption} tabindex="0">
                  <table>
                    <caption>{block.caption}</caption>
                    <thead>
                      <tr>
                        {block.head.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) =>
                            i === 0 ? (
                              <th scope="row">
                                <LegalText text={cell} lang={lang} />
                              </th>
                            ) : (
                              <td>
                                <LegalText text={cell} lang={lang} />
                              </td>
                            ),
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <dl class="legal__company" aria-label={dict.legal.companyDetails}>
                  {companyRows.map(([term, value, href]) => (
                    <div>
                      <dt>{term}</dt>
                      <dd>{href ? <a href={href}>{value}</a> : value}</dd>
                    </div>
                  ))}
                </dl>
              ),
            )}
          </section>
        ))
      }

      <footer class="legal__related">
        <h2>{dict.legal.related}</h2>
        <ul>
          {related.map((p) => <li><a href={pathFor(p, lang)}>{dict.footer[p]}</a></li>)}
        </ul>
        <p><a class="text-link" href={pathFor('home', lang)}>{dict.legal.back}</a></p>
      </footer>
    </article>
  </main>
  <Footer lang={lang} page={page} />
</Base>

<script>
  import '../scripts/site.ts';
  // Print button only appears when JavaScript can run it.
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  });
</script>

<style>
  .legal-main {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .legal {
    max-width: calc(46rem + 2 * var(--gutter));
    display: grid;
    gap: 1rem;
  }
  .legal__head {
    display: grid;
    gap: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--grey-200);
  }
  h1 {
    font-size: var(--step-4);
  }
  .legal__updated {
    color: var(--grey-500);
    font-size: 0.9rem;
  }
  .legal__intro {
    font-size: var(--step-1);
    color: #2a3a52;
  }
  .legal__draft-banner {
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--gold-600);
    background: #fbf3e2;
    color: #5c4210;
    font-weight: 500;
  }
  .legal__actions:has(> [hidden]:only-child) {
    display: none;
  }
  .legal__print {
    justify-self: start;
    background: none;
    border-top: 0;
    border-inline: 0;
    padding-inline: 0;
    font: 600 0.9rem/1.4 var(--font-sans);
    color: var(--navy-900);
    cursor: pointer;
  }
  .legal__toc {
    margin-block: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--grey-50);
    border-top: 3px solid var(--gold-500);
  }
  .legal__toc h2 {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin-bottom: 0.75rem;
  }
  .legal__toc ol {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
  }
  .legal__toc a {
    color: var(--navy-900);
  }
  section {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.5rem;
  }
  section h2 {
    font-size: var(--step-2);
  }
  section p,
  section li {
    color: #2a3a52;
  }
  section ul {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  section a,
  .legal__related a:not(.text-link) {
    color: var(--navy-900);
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
  }
  .legal__company {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--grey-200);
  }
  .legal__company div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--grey-200);
    font-size: 0.95rem;
  }
  .legal__company dt {
    color: var(--grey-500);
  }
  .legal__company dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .legal__table {
    overflow-x: auto;
    border: 1px solid var(--grey-200);
  }
  .legal__table:focus-visible {
    outline-offset: 2px;
  }
  table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  caption {
    text-align: left;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--navy-900);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--grey-200);
  }
  thead th {
    background: var(--grey-50);
    color: var(--navy-900);
    font-weight: 600;
  }
  tbody th {
    font-weight: 600;
    color: var(--navy-900);
  }
  .legal__related {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--grey-200);
    display: grid;
    gap: 0.75rem;
  }
  .legal__related h2 {
    font-size: var(--step-1);
  }
  .legal__related ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  :global(mark.legal-draft) {
    background: #fbf3e2;
    color: #5c4210;
    padding: 0.05em 0.3em;
    border: 1px dashed var(--gold-600);
    border-radius: var(--radius);
  }
  :global(.legal-draft__label) {
    font-weight: 700;
  }
  @media (max-width: 30rem) {
    .legal__company div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
  @media print {
    .legal-main {
      padding: 0;
    }
    .legal__toc,
    .legal__actions,
    .legal__related {
      display: none;
    }
    .legal__table {
      overflow: visible;
      border: 0;
    }
    table {
      min-width: 0;
    }
    section {
      break-inside: auto;
    }
    section h2 {
      break-after: avoid;
    }
    a {
      color: #000;
    }
  }
</style>
