---
import RoleCtas from './RoleCtas.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = t(lang).start.hero;
---

<section class="start-hero section--navy" aria-labelledby="start-title">
  <div class="container start-hero__inner">
    <div class="start-hero__copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="start-title">{h.title}</h1>
      <p class="start-hero__lead">{h.lead}</p>
      <p class="start-hero__prompt">{h.prompt}</p>
      <RoleCtas lang={lang} position="hero" tone="navy" />
      <p class="start-hero__trust">{h.trust}</p>
    </div>
    <dl class="start-hero__facts">
      {
        h.facts.map((f) => (
          <div>
            <dt>{f.term}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .start-hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem);
  }
  .start-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }
  .start-hero h1 {
    margin: 0.5rem 0 1.25rem;
    max-width: 18ch;
    font-size: var(--step-4);
    line-height: 1.08;
    color: var(--white);
  }
  .start-hero__lead {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: #dfe5ee;
  }
  .start-hero__prompt {
    margin: 2rem 0 0.75rem;
    font-weight: 600;
    color: var(--white);
  }
  .start-hero__trust {
    margin-top: 1.5rem;
    max-width: 38rem;
    font-size: 0.88rem;
    color: var(--navy-300);
  }
  .start-hero__facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .start-hero__facts div {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .start-hero__facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-500);
  }
  .start-hero__facts dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--white);
  }
  @media (max-width: 60rem) {
    .start-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
