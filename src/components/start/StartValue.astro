---
import RoleCtas from './RoleCtas.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const v = t(lang).start.value;
const blocks = [
  { id: 'buyers', ...v.buyers },
  { id: 'suppliers', ...v.suppliers },
];
---

<section class="section start-value" aria-labelledby="value-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{v.eyebrow}</p>
      <h2 id="value-title">{v.title}</h2>
    </header>
    <div class="start-value__grid">
      {
        blocks.map((b) => (
          <article class="start-value__card" aria-labelledby={`value-${b.id}`}>
            <h3 id={`value-${b.id}`}>{b.title}</h3>
            <p class="start-value__lead">{b.lead}</p>
            <ul>
              {b.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="start-value__note">{v.note}</p>
    <RoleCtas lang={lang} position="value" />
  </div>
</section>

<style>
  .start-value__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .start-value__card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--gold-500);
  }
  .start-value__card h3 {
    margin: 0 0 0.5rem;
    font-size: var(--step-2);
  }
  .start-value__lead {
    color: var(--text-muted);
  }
  .start-value__card ul {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .start-value__card li {
    position: relative;
    padding-left: 1.5rem;
  }
  .start-value__card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.75rem;
    height: 1px;
    background: var(--gold-500);
  }
  .start-value__note {
    margin: 1.75rem 0 1.25rem;
    font-size: 0.93rem;
    color: var(--text-muted);
  }
  @media (max-width: 48rem) {
    .start-value__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
