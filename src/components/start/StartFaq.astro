---
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = t(lang).start.faq;
---

<section class="section start-faq" aria-labelledby="start-faq-title">
  <div class="container start-faq__inner">
    <header class="section-head">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id="start-faq-title">{f.title}</h2>
    </header>
    <div class="start-faq__list">
      {
        f.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .start-faq__inner {
    max-width: 52rem;
  }
  .start-faq__list {
    border-top: 1px solid var(--rule);
  }
  .start-faq details {
    border-bottom: 1px solid var(--rule);
  }
  .start-faq summary {
    position: relative;
    padding: 1.15rem 2.5rem 1.15rem 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    cursor: pointer;
    list-style: none;
  }
  .start-faq summary::-webkit-details-marker {
    display: none;
  }
  .start-faq summary::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 1.55rem;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.5px solid var(--gold-600);
    border-bottom: 1.5px solid var(--gold-600);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }
  .start-faq details[open] summary::after {
    transform: rotate(-135deg);
    top: 1.8rem;
  }
  .start-faq details p {
    padding-bottom: 1.25rem;
    color: var(--text-muted);
  }
</style>
