---
import { site } from '../config/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="page-head section--navy">
  <div class="container">
    <p class="eyebrow">{site.brand}</p>
    <h1>{title}</h1>
  </div>
</header>

<style>
  .page-head {
    padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }
  .page-head h1 {
    margin: 0;
    font-size: var(--step-4);
    color: var(--white);
  }
</style>
