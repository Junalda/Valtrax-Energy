---
import { t, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const dict = t(Astro.props.lang);
---

<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{dict.process.eyebrow}</p>
      <h2 id="process-title">{dict.process.title}</h2>
      <p>{dict.process.intro}</p>
    </header>
    <ol class="steps">
      {
        dict.process.steps.map((s, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0 clamp(1rem, 0.5rem + 1.5vw, 2rem);
    counter-reset: step;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.75rem;
    padding-top: 2.25rem;
  }
  .step::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    right: calc(-1 * clamp(1rem, 0.5rem + 1.5vw, 2rem));
    height: 1px;
    background: var(--grey-200);
  }
  .step:last-child::before {
    right: 0;
  }
  .step::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0.9rem;
    height: 0.9rem;
    border: 1px solid var(--gold-500);
    background: var(--white);
    transform: rotate(45deg);
  }
  .step__num {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--gold-600);
  }
  .step h3 {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .step p {
    font-size: 0.95rem;
    color: var(--grey-500);
  }
  @media (max-width: 64rem) {
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 40rem;
    }
    .step {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      grid-template-rows: auto;
      column-gap: 1rem;
      row-gap: 0.4rem;
      padding: 0 0 2.25rem 2.5rem;
    }
    .step::before {
      top: 0.9rem;
      bottom: 0;
      left: 0.44rem;
      right: auto;
      width: 1px;
      height: auto;
    }
    .step:last-child::before {
      display: none;
    }
    .step::after {
      top: 0.25rem;
    }
    .step__num {
      grid-row: span 2;
      font-size: 1.6rem;
    }
  }
</style>
