---
import { t, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const dict = t(Astro.props.lang);
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <header class="section-head">
      <p class="eyebrow">{dict.faq.eyebrow}</p>
      <h2 id="faq-title">{dict.faq.title}</h2>
    </header>
    <div class="faq">
      {
        dict.faq.items.map((item) => (
          <details class="faq__item">
            <summary>
              <h3>{item.q}</h3>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .faq {
    border-top: 1px solid var(--navy-900);
  }
  .faq__item {
    border-bottom: 1px solid var(--grey-200);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: var(--step-1);
    font-weight: 500;
  }
  summary:hover h3 {
    color: var(--navy-700);
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: var(--gold-600);
    transition: transform 0.2s ease;
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__item p {
    max-width: var(--measure);
    padding-bottom: 1.5rem;
    color: #2a3a52;
  }
  @media (max-width: 52rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__grid .section-head {
      margin-bottom: 0;
    }
  }
</style>
