---
import { site } from '../config/site';

interface Props {
  /** `dark` = navy logo for light backgrounds, `light` = reversed logo for navy backgrounds. */
  tone?: 'dark' | 'light';
  size?: 'md' | 'lg';
  /** Header logo loads eagerly; others may be lazy. */
  eager?: boolean;
}
const { tone = 'dark', size = 'md', eager = false } = Astro.props;
const asset = tone === 'light' ? site.logo.lockupLight : site.logo.lockup;
---

<img
  class:list={['logo', `logo--${size}`]}
  src={asset.src}
  width={asset.width}
  height={asset.height}
  alt={site.brand}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
/>

<style>
  /* Height-driven sizing keeps the logo's intrinsic aspect ratio (≈4.46:1). */
  .logo {
    display: block;
    width: auto;
    height: 3.25rem;
    max-width: 100%;
  }
  .logo--lg {
    height: 3.75rem;
  }
  @media (max-width: 30rem) {
    .logo {
      height: 2.75rem;
    }
  }
  @media (max-width: 22rem) {
    .logo {
      height: 2.4rem;
    }
  }
</style>
