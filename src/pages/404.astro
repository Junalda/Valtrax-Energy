---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { t } from '../i18n';
const en = t('en');
const nl = t('nl');
---

<Base lang="en" page="home" title={`${en.notFound.title} | Valtrax Energy`} description={en.notFound.text} noindex structuredData={false}>
  <main id="main" class="nf">
    <a href="/" aria-label={en.nav.home}><Logo eager /></a>
    <h1>{en.notFound.title}</h1>
    <p>{en.notFound.text} <a href="/">{en.notFound.back}</a></p>
    <p lang="nl">{nl.notFound.text} <a href="/nl/" hreflang="nl">{nl.notFound.back}</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1.25rem;
    padding: var(--gutter);
    text-align: center;
    justify-items: center;
  }
  h1 {
    font-size: var(--step-3);
  }
</style>
